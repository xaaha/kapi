<form class="kapi-form" data-kapi-preset="form" name="review" data-kapi-form="review" data-kapi-id="f0000001">
  <p>Intro text.</p>
  <fieldset class="kapi-choice" data-kapi-preset="choice" data-kapi-field="verdict" data-kapi-choice="single" data-kapi-id="f0000002"><legend data-kapi-text="f0000002" data-kapi-lead="">Ship it?</legend><div class="kapi-choice-opts"><label class="kapi-opt" data-kapi-preset="opt" data-kapi-id="f0000003"><input type="radio" name="verdict" value="yes"><span data-kapi-text="f0000003">Yes</span></label><label class="kapi-opt" data-kapi-preset="opt"><input type="radio" name="verdict" value="no"><span>No, <em>wait</em></span></label></div></fieldset>
  <fieldset class="kapi-choice" data-kapi-preset="choice" data-kapi-field="areas" data-kapi-choice="multiple" data-kapi-id="f0000004"><div class="kapi-choice-opts"><label class="kapi-opt" data-kapi-preset="opt"><input type="checkbox" name="areas" value="ui"><span>ui</span></label><label class="kapi-opt" data-kapi-preset="opt"><input type="checkbox" name="areas" value="api"><span>API</span></label></div></fieldset>
  <label class="kapi-text" data-kapi-preset="text" data-kapi-field="notes" data-kapi-id="f0000005"><span class="kapi-text-label" data-kapi-text="f0000005">Notes</span><textarea name="notes" rows="3"></textarea></label>
  <div class="kapi-error" data-kapi-preset="choice" title="needs at least one <kapi-opt value=&quot;...&quot;>" data-kapi-id="f0000006"><span class="kapi-error-tag" aria-label="Rendering warning">Could not style &lt;kapi-choice&gt;: needs at least one &lt;kapi-opt value="..."&gt;</span>No options</div>
  <div class="kapi-error" data-kapi-preset="choice" title="needs a name attribute" data-kapi-id="f0000007"><span class="kapi-error-tag" aria-label="Rendering warning">Could not style &lt;kapi-choice&gt;: needs a name attribute</span><span class="kapi-error" data-kapi-preset="opt" title="its <kapi-choice> needs a name attribute"><span class="kapi-error-tag" aria-label="Rendering warning">Could not style &lt;kapi-opt&gt;: its &lt;kapi-choice&gt; needs a name attribute</span>x</span></div>
  <fieldset class="kapi-choice" data-kapi-preset="choice" data-kapi-field="noval" data-kapi-choice="single"><div class="kapi-choice-opts"><span class="kapi-error" data-kapi-preset="opt" title="needs a value attribute" data-kapi-id="f0000008"><span class="kapi-error-tag" aria-label="Rendering warning">Could not style &lt;kapi-opt&gt;: needs a value attribute</span>no value</span></div></fieldset>
  <div class="kapi-error" data-kapi-preset="text" title="needs a name attribute" data-kapi-id="f0000009"><span class="kapi-error-tag" aria-label="Rendering warning">Could not style &lt;kapi-text&gt;: needs a name attribute</span>no name</div>
<div class="kapi-form-actions"><button type="submit">Send answers</button></div></form>
<div class="kapi-error" data-kapi-preset="form" title="needs a name attribute" data-kapi-id="f0000010"><span class="kapi-error-tag" aria-label="Rendering warning">Could not style &lt;kapi-form&gt;: needs a name attribute</span><label class="kapi-text" data-kapi-preset="text" data-kapi-field="a"><span class="kapi-text-label">a</span><textarea name="a" rows="3"></textarea></label></div>
<div class="kapi-error" data-kapi-preset="text" title="must be a direct child of <kapi-form>" data-kapi-id="f0000011"><span class="kapi-error-tag" aria-label="Rendering warning">Could not style &lt;kapi-text&gt;: must be a direct child of &lt;kapi-form&gt;</span>Orphan</div>
<div class="kapi-error" data-kapi-preset="opt" title="must be a direct child of <kapi-choice>" data-kapi-id="f0000012"><span class="kapi-error-tag" aria-label="Rendering warning">Could not style &lt;kapi-opt&gt;: must be a direct child of &lt;kapi-choice&gt;</span>Orphan</div>
