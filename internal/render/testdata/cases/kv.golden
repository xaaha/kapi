<dl class="kapi-kv" data-kapi-preset="kv" data-kapi-id="k0000001">
  <!-- who and when -->
  <div class="kapi-kv-item" data-kapi-preset="item" data-kapi-id="k0000002"><dt>Owner</dt><dd>Pratik</dd></div>
  <div class="kapi-kv-item" data-kapi-preset="item" data-kapi-id="k0000003"><dt>Status</dt><dd><span class="kapi-badge kapi-tone-warning" data-kapi-preset="badge">in review</span></dd></div>
  <div class="kapi-kv-item" data-kapi-preset="item" data-kapi-id="k0000004"><dt>Rollback</dt><dd><p>Flip the flag back.</p><p>Then restart the daemon.</p></dd></div>
