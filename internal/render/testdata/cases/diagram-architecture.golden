<figure class="kapi-diagram kapi-diagram-architecture" data-kapi-preset="diagram" data-kapi-dir="lr" data-kapi-id="r0000001"><svg xmlns="http://www.w3.org/2000/svg" viewBox="-12 -142.6 941.5 290.3" width="941.5" height="290.3" role="img" aria-label="architecture diagram: Agent (any harness), plan.html, kapi daemon (Go, one per machine), ~/.kapi on disk, Browser page, Private hub"><defs><marker id="kapi-arrow-e59fde18" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="kd-arrow" d="M0,0 L10,5 L0,10 z"></path></marker></defs><path class="kd-edge" d="M223,-54.8 C286.8,-54.8 286.8,-92.6 350.7,-92.6" marker-end="url(#kapi-arrow-e59fde18)"></path><path class="kd-edge" d="M223,-38.8 C281,-38.8 281,42.9 339,42.9" marker-start="url(#kapi-arrow-e59fde18)" marker-end="url(#kapi-arrow-e59fde18)"></path><path class="kd-edge" d="M216.5,76.8 C277.8,76.8 277.8,58.9 339,58.9" marker-start="url(#kapi-arrow-e59fde18)" marker-end="url(#kapi-arrow-e59fde18)"></path><path class="kd-edge" d="M617.8,42.9 C665.9,42.9 665.9,-3.4 714,-3.4" marker-end="url(#kapi-arrow-e59fde18)"></path><path class="kd-edge kd-dashed" d="M617.8,58.9 C677.3,58.9 677.3,105.1 736.8,105.1" marker-end="url(#kapi-arrow-e59fde18)"></path><g class="kd-label"><rect x="248.8" y="-97.7" width="76" height="18" rx="4"></rect><text x="286.8" y="-88.7">edits file</text></g><g class="kd-label"><rect x="256.2" y="8.1" width="49.6" height="18" rx="4"></rect><text x="281" y="17.1">socket</text></g><g class="kd-label"><rect x="239.7" y="58.8" width="76" height="18" rx="4"></rect><text x="277.7" y="67.8">HTTP + SSE</text></g><g class="kd-label"><rect x="641.1" y="-4.2" width="49.6" height="18" rx="4"></rect><text x="665.9" y="4.8">append</text></g><g class="kd-label"><rect x="649.2" y="88" width="56.2" height="18" rx="4"></rect><text x="677.3" y="97">publish</text></g><path class="kd-edge" d="M478.4,-54.6 L478.4,5.4" marker-start="url(#kapi-arrow-e59fde18)" marker-end="url(#kapi-arrow-e59fde18)"></path><g class="kd-label"><rect x="414" y="-40.6" width="128.8" height="32" rx="4"></rect><text x="478.4" y="-31.6">reads, writes ops,</text><text x="478.4" y="-17.6">notices your edits</text></g><g class="kd-node kd-arch"><rect x="0" y="-92.3" width="223" height="91" rx="10"></rect><text class="kd-title" x="14" y="-71.8">Agent (any harness)</text><text class="kd-sub" x="14" y="-50.8">kapi watch: one line per event</text><text class="kd-sub" x="14" y="-35.8">kapi say, pending, preset</text><text class="kd-sub" x="14" y="-20.8">writes plan.html directly</text></g><g class="kd-node kd-arch"><rect x="350.7" y="-130.6" width="255.5" height="76" rx="10"></rect><text class="kd-title" x="364.7" y="-110.1">plan.html</text><text class="kd-sub" x="364.7" y="-89.1">page source: prose + kapi-* presets</text><text class="kd-sub" x="364.7" y="-74.1">every block has a data-kapi-id</text></g><g class="kd-node kd-arch"><rect x="339" y="5.4" width="278.8" height="91" rx="10"></rect><text class="kd-title" x="353" y="25.9">kapi daemon (Go, one per machine)</text><text class="kd-sub" x="353" y="46.9">event log and cursors per page</text><text class="kd-sub" x="353" y="61.9">page store: ids, revisions, undo</text><text class="kd-sub" x="353" y="76.9">renders presets to HTML + SVG</text></g><g class="kd-node kd-arch"><rect x="714" y="-41.4" width="203.5" height="76" rx="10"></rect><text class="kd-title" x="728" y="-20.9">~/.kapi on disk</text><text class="kd-sub" x="728" y="0.1">pages/&lt;id&gt;/events.ndjson</text><text class="kd-sub" x="728" y="15.1">cursors.json, revs/&lt;n&gt;.html</text></g><g class="kd-node kd-arch"><rect x="6.5" y="38.8" width="210" height="76" rx="10"></rect><text class="kd-title" x="20.5" y="59.3">Browser page</text><text class="kd-sub" x="20.5" y="80.3">Select toggle, block toolbar</text><text class="kd-sub" x="20.5" y="95.3">chat panel, status dot</text></g><g class="kd-node kd-arch kd-planned"><rect x="736.8" y="74.6" width="158" height="61" rx="10"></rect><text class="kd-title" x="750.8" y="95.1">Private hub</text><text class="kd-sub" x="750.8" y="116.1">R2 + Worker + Access</text></g></svg><figcaption class="kapi-diagram-legend"><span class="kapi-badge kapi-tone-grey kd-legend-planned">planned</span></figcaption></figure>
